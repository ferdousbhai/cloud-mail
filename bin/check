#!/bin/bash
# Every check a change must pass. .githooks/pre-push runs it on this machine before a push (set NO_CHECK=1 to push
# without it), and GitHub runs it on every push (.github/workflows/check.yml).
#
#   bin/check                        # Rust (format, clippy, tests), the app's QA, the worker (tests, types), packaging
#   CLOUDMAIL_CHECK_NO_GTK=1 bin/check   # the same without the desktop app, on a machine without GTK 4 and WebKitGTK
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

# Validate vendored support before the more expensive product checks.
python3 bin/check-shared-support

step() { printf '\n==> %s\n' "$*"; }

# The desktop app needs GTK 4 and WebKitGTK 6.0 to build. Without them the check fails rather than pass having never
# built the app: a green run must mean every crate was checked. Leaving the app out is a choice made out loud, with
# CLOUDMAIL_CHECK_NO_GTK=1, and the run says it did.
crates=(-p cloudmail-api -p cloudmail)
if [[ ${CLOUDMAIL_CHECK_NO_GTK:-} == 1 ]]; then
  echo "note: CLOUDMAIL_CHECK_NO_GTK=1, so cloudmail-gtk and its QA are not checked" >&2
elif pkg-config --exists gtk4 webkitgtk-6.0 2>/dev/null; then
  crates+=(-p cloudmail-gtk)
else
  echo "error: gtk4 and webkitgtk-6.0 are needed to check cloudmail-gtk; install them, or set CLOUDMAIL_CHECK_NO_GTK=1 to check without the app" >&2
  exit 1
fi

step "rustfmt (fix with: cargo fmt --all)"
cargo fmt --all -- --check
step "clippy"
cargo clippy --locked "${crates[@]}" --all-targets -- -D warnings
step "cargo test"
cargo test --locked "${crates[@]}"

# The app's flows on stand-in mail, driven by omui's scripted QA on a hidden broadway display (dev/qa.sh); its shots
# of the main window land in target/qa/.
if [[ " ${crates[*]} " == *" cloudmail-gtk "* ]]; then
  step "app QA (crates/cloudmail-gtk/dev/qa)"
  cargo build --locked -p cloudmail-gtk --features qa
  CLOUDMAIL_QA_SHOTS=target/qa crates/cloudmail-gtk/dev/qa.sh target/debug/cloudmail-gtk crates/cloudmail-gtk/dev/qa/*.jsonl
fi

step "worker"
(cd worker && { [[ -d node_modules ]] || bun install --frozen-lockfile; } && bun test && bun run typecheck)

step "packaging"
bash packaging/repo/test.sh
python3 packaging/repo/test_arch.py
bash -n bin/build-package bin/release bin/release-on-tag bin/verify-release install.sh .githooks/pre-push

printf '\nAll checks passed.\n'
