#!/bin/bash
# Release a pushed version tag with no separate command. The pre-push hook (.githooks/pre-push)
# starts this in the background whenever a push carries a tag vX.Y.Z:
#
#   git tag -a v0.3.2 -F notes.md --cleanup=verbatim && git push origin v0.3.2
#
# It waits until GitHub has the tag, drafts the GitHub release with the tag's message as its
# notes (commit-generated notes for a lightweight tag), runs bin/release (gpg asks for the
# signing key's passphrase in a desktop prompt) and reports the outcome as a desktop
# notification, then moves the omarchy-pkgs pull request to the new version while it is open.
# Everything it prints goes to ~/.local/state/cloudmail/release-<version>.log.
#
#   bin/release-on-tag <version> [--dry-run]    # --dry-run checks and logs, changes nothing
set -uo pipefail
cd "$(dirname "$0")/.."

version="${1:?usage: bin/release-on-tag <version> [--dry-run]}"
dry_run=$([[ ${2:-} == --dry-run ]] && echo 1 || echo 0)
tag="v$version"
gh_repo=ferdousbhai/cloud-mail
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cloudmail"
mkdir -p "$log_dir"
log="$log_dir/release-$version.log"
exec >>"$log" 2>&1

step() { printf '\n==> %s (%s)\n' "$*" "$(date +%T)"; }
notify() {
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send "$1" "$2" -t 15000
  else
    notify-send "$1" "$2"
  fi
}
fail() {
  echo "error: $*"
  notify "Cloudmail $version: release failed" "$* (log: $log)"
  exit 1
}

step "Waiting for $tag on GitHub"
for _ in $(seq 1 120); do
  gh api "repos/$gh_repo/git/ref/tags/$tag" >/dev/null 2>&1 && break
  sleep 5
done
gh api "repos/$gh_repo/git/ref/tags/$tag" >/dev/null 2>&1 || fail "$tag never reached GitHub"

step "Drafting the $tag release"
if gh release view "$tag" --repo "$gh_repo" >/dev/null 2>&1; then
  echo "the release exists already"
elif ((dry_run)); then
  echo "would create a draft release for $tag"
elif [[ $(git cat-file -t "$tag" 2>/dev/null) == tag ]]; then
  git tag -l --format='%(contents:body)' "$tag" >"$log_dir/notes-$version.md"
  # An annotated tag's subject is its title; a message with no body gets generated notes.
  if [[ -s $log_dir/notes-$version.md ]]; then
    gh release create "$tag" --repo "$gh_repo" --draft --verify-tag \
      --title "Cloudmail $version" --notes-file "$log_dir/notes-$version.md" || fail "could not draft the release"
  else
    gh release create "$tag" --repo "$gh_repo" --draft --verify-tag \
      --title "Cloudmail $version" --generate-notes || fail "could not draft the release"
  fi
else
  gh release create "$tag" --repo "$gh_repo" --draft --verify-tag \
    --title "Cloudmail $version" --generate-notes || fail "could not draft the release"
fi

# Carry the new version to the omarchy-pkgs pull request while it is open (once merged, Omarchy's
# tag watch takes over). Works in a throwaway worktree of the PR branch, starting from the
# fork's copy, so a checkout another session is using is never touched; pushes fast-forward only.
bump_omarchy_pkgs() {
  local pkgs="${CLOUDMAIL_OMARCHY_PKGS:-$HOME/github.com/ferdousbhai/omarchy-pkgs}" branch=cloudmail pr=724
  local state work sum
  [[ -d $pkgs/.git ]] || { echo "no omarchy-pkgs checkout at $pkgs; skipped"; return 0; }
  state="$(gh pr view "$pr" --repo omacom/omarchy-pkgs --json state --jq .state 2>/dev/null)"
  [[ $state == OPEN ]] || { echo "omacom/omarchy-pkgs#$pr is ${state:-unknown}; skipped"; return 0; }
  sum="$(curl -fsSL "https://github.com/$gh_repo/archive/refs/tags/$tag.tar.gz" | sha256sum | cut -d' ' -f1)"
  [[ $sum =~ ^[0-9a-f]{64}$ ]] || return 1
  if ((dry_run)); then
    echo "would set pkgbuilds/cloudmail/PKGBUILD to $version (sha256 $sum) on $branch and push"
    return 0
  fi
  # A private ref, so no remote-tracking branch or FETCH_HEAD another session relies on moves.
  local base=refs/cloudmail-release/base status=0
  work="$(mktemp -d)/omarchy-pkgs"
  git -C "$pkgs" fetch -q origin "+refs/heads/$branch:$base" || return 1
  git -C "$pkgs" worktree add -q --detach "$work" "$base" || { git -C "$pkgs" update-ref -d "$base"; return 1; }
  cp packaging/aur/cloudmail/PKGBUILD "$work/pkgbuilds/cloudmail/PKGBUILD"
  sed -i "s/^sha256sums=.*/sha256sums=('$sum')/" "$work/pkgbuilds/cloudmail/PKGBUILD"
  if git -C "$work" diff --quiet; then
    echo "omarchy-pkgs already has $version"
  else
    git -C "$work" commit -qam "cloudmail $version" && git -C "$work" push -q origin "HEAD:refs/heads/$branch" || status=1
  fi
  git -C "$pkgs" worktree remove --force "$work"
  git -C "$pkgs" update-ref -d "$base"
  return $status
}

if ((dry_run)); then
  step "Dry run: would run bin/release $version"
  bump_omarchy_pkgs
  exit 0
fi

notify "Cloudmail $version" "Building and signing the release; gpg will ask for the signing key's passphrase"
step "bin/release $version"
bin/release "$version" || fail "bin/release stopped"

step "Updating the omarchy-pkgs pull request"
if bump_omarchy_pkgs; then
  echo "omarchy-pkgs is on $version"
else
  echo "the omarchy-pkgs bump failed"
  notify "Cloudmail $version" "Released, but the omarchy-pkgs bump failed (log: $log)"
fi
step "Done: Cloudmail $version is released"
notify "Cloudmail $version released" "Published and verified; omarchy update brings it in"
