#!/bin/bash
# Install a published release the way users do, in a clean Arch container:
#
#   bin/verify-release 0.1.0
#
# Runs the public one-liner against GitHub's releases/latest/download and
# checks that cloudmail $version is installed and runs.
set -euo pipefail

version="${1:?usage: bin/verify-release <version>}"
url="${CLOUDMAIL_INSTALL_URL:-https://github.com/ferdousbhai/cloud-mail/releases/latest/download/install.sh}"

docker run --rm docker.io/archlinux:latest bash -euo pipefail -c "
  pacman-key --init >/dev/null 2>&1
  pacman-key --populate archlinux >/dev/null 2>&1
  curl -fsSL '$url' | bash
  installed=\$(pacman -Q cloudmail | cut -d' ' -f2)
  [[ \$installed == $version-* ]] || { echo \"expected cloudmail $version, found \$installed\" >&2; exit 1; }
  [[ \$(cloudmail --version) == \"cloudmail $version\" ]] || { echo \"cloudmail --version says \$(cloudmail --version), expected $version\" >&2; exit 1; }
  cmail --version >/dev/null
  test -x /usr/bin/cloudmail-gtk
  for f in wrangler.template.jsonc package.json tsconfig.json src/index.ts src/ingest.ts migrations/0001_init.sql; do
    test -f /usr/share/cloudmail/worker/\$f || { echo \"the package is missing worker/\$f\" >&2; exit 1; }
  done
  echo \"verified: cloudmail \$installed from the signed repository\"
"
