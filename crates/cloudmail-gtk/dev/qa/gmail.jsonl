{"do":"wait","role":"window","name":"Accounts","visible":true}
{"do":"click","role":"button","name":"Gmail"}
{"do":"wait","role":"label","name":"Gmail (gmail, signed in)","visible":true}
{"do":"wait","role":"button","name":"Gmail","sensitive":true}
{"do":"click","role":"button","name":"Gmail"}
{"do":"wait","role":"label","name":"me@gmail.example is already linked here as gmail","visible":true}
{"do":"wait","role":"button","name":"Gmail","sensitive":true}
{"do":"quit"}
