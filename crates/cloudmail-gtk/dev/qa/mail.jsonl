# The mail on dev/fake-worker's stand-in data: dev/qa.sh runs it (bin/check keeps the shots in target/qa).
# A broadway display is 1024 by 768, so the window starts wide; WebKit's message view is not in the shots.

# The Inbox's threads, a paperclip on those with an attachment; j opens the first and marks it read, j and k move
# (the second is read once it has opened), and the reader's actions show.
{"do":"wait","role":"label","name":"5 conversations · 2 unread"}
{"do":"wait","role":"list-item","name":"Trail map for Saturday","visible":true,"selected":false}
{"do":"wait","role":"presentation","in":{"role":"list-item","name":"Trail map for Saturday"},"visible":true}
{"do":"wait","role":"presentation","in":{"role":"list-item","name":"Re: invoice 2291"},"visible":true}
{"do":"key","keys":"j"}
{"do":"wait","role":"list-item","name":"Trail map for Saturday","selected":true}
{"do":"wait","role":"label","name":"5 conversations · 1 unread"}
{"do":"wait","role":"button","name":"Reply (r)","visible":true}
{"do":"shot","path":"inbox.png"}
{"do":"key","keys":"j"}
{"do":"wait","role":"list-item","name":"Autumn catalogue","selected":true}
{"do":"wait","role":"label","name":"5 conversations"}
{"do":"key","keys":"k"}
{"do":"wait","role":"list-item","name":"Trail map for Saturday","selected":true}

# u marks it unread again, in its row and in the count above the list, with a toast; its close button dismisses it.
{"do":"wait","role":"label","name":" ","in":{"role":"list-item","name":"Trail map for Saturday"}}
{"do":"key","keys":"u"}
{"do":"wait","toasts":["Marked unread"]}
{"do":"wait","role":"label","name":"●","in":{"role":"list-item","name":"Trail map for Saturday"}}
{"do":"wait","role":"label","name":"5 conversations · 1 unread"}
{"do":"click","role":"button","name":"Dismiss","in":{"role":"alert","name":"Marked unread"}}
{"do":"wait","toasts":[]}

# The boxes by number, and by the sidebar.
{"do":"key","keys":"3"}
{"do":"wait","role":"list-item","name":"Boots","visible":true}
{"do":"shot","path":"archive.png"}
{"do":"key","keys":"4"}
{"do":"wait","role":"list-item","name":"Lake photos","visible":true}
{"do":"key","keys":"1"}
{"do":"wait","role":"list-item","name":"Brightline Offers","visible":true}
{"do":"shot","path":"screener.png"}
{"do":"select","role":"list-item","name":"Inbox"}
{"do":"wait","role":"list-item","name":"Trail map for Saturday","visible":true}

# Search: / gives it the keyboard, Enter searches every box, Escape goes back to the Inbox.
{"do":"key","keys":"slash"}
{"do":"wait","role":"search-box","name":"Search mail · ~ meaning","focused":true}
{"do":"type","text":"ticket"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"list-item","name":"Your ticket to Halden","visible":true}
{"do":"wait","role":"list-item","name":"Autumn catalogue","visible":false}
{"do":"shot","path":"search.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"list-item","name":"Autumn catalogue","visible":true}

# R refreshes; r would reply.
{"do":"key","keys":"R"}
{"do":"wait","toasts":["Refreshed"]}

# ? lists the keys in a window of its own, which Escape, ? and q close.
{"do":"key","keys":"question"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":true}
{"do":"wait","role":"label","name":"Toggle unread","visible":true}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":false}
{"do":"key","keys":"question"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":true}
{"do":"key","keys":"question"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":false}
{"do":"key","keys":"question"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":true}
{"do":"key","keys":"q"}
{"do":"wait","role":"window","name":"Keyboard shortcuts","visible":false}

# A narrow window: the sidebar is its icons.
{"do":"resize","width":800,"height":700}
{"do":"wait","size":[800,700]}
{"do":"wait","role":"label","name":"Compose","visible":false}
{"do":"wait","role":"button","name":"New message (c)","visible":true}
{"do":"shot","path":"narrow.png"}
{"do":"quit"}
