# Writing mail on dev/fake-worker's stand-in data. QA's shots are of the main window; dev/preview.sh pictures the
# compose window itself.

# A new message: the To field has the keyboard, and Ctrl+Enter asks for a recipient; Tab walks to the subject and the
# body; Send sends it. (A key that closes its window is not pressed: omui 0.5.1 may miss its release, which goes
# nowhere once the window has gone.)
{"do":"click","role":"button","name":"New message (c)"}
{"do":"wait","role":"text-box","name":"name@example.com, …","focused":true}
{"do":"wait","role":"button","name":"Send","in":{"role":"window","name":"New message"},"sensitive":true}
{"do":"key","keys":"<Control>Return"}
{"do":"wait","role":"label","name":"Add at least one recipient.","visible":true}
{"do":"type","text":"sam@example.com"}
{"do":"key","keys":"Tab"}
{"do":"key","keys":"Tab"}
{"do":"type","text":"Lake photos"}
{"do":"key","keys":"Tab"}
{"do":"type","text":"All forty, in one folder."}
{"do":"click","role":"button","name":"Send","in":{"role":"window","name":"New message"}}
{"do":"wait","role":"window","name":"New message","visible":false}
{"do":"wait","toasts":["Sent"]}

# An edited draft asks before its window closes: Keep editing keeps it, Discard closes it.
{"do":"click","role":"button","name":"New message (c)"}
{"do":"wait","role":"text-box","name":"name@example.com, …","focused":true}
{"do":"type","text":"ines@example.net"}
{"do":"click","role":"button","name":"Close","in":{"role":"window","name":"New message"}}
{"do":"wait","dialog":"Discard this draft?"}
{"do":"click","role":"button","name":"Keep editing"}
{"do":"wait","dialog":null}
{"do":"wait","role":"text-box","name":"name@example.com, …","text":"ines@example.net"}
{"do":"click","role":"button","name":"Close","in":{"role":"window","name":"New message"}}
{"do":"wait","dialog":"Discard this draft?"}
{"do":"click","role":"button","name":"Discard"}
{"do":"wait","dialog":null}
{"do":"wait","role":"window","name":"New message","visible":false}

# A reply is addressed to the sender; untouched, it closes without asking.
{"do":"select","role":"list-item","name":"Trail map for Saturday"}
{"do":"wait","role":"list-item","name":"Trail map for Saturday","selected":true}
{"do":"click","role":"button","name":"Reply (r)"}
{"do":"wait","role":"text-box","name":"name@example.com, …","text":"Sam Okafor <sam@example.com>"}
{"do":"click","role":"button","name":"Close","in":{"role":"window","name":"Reply"}}
{"do":"wait","role":"window","name":"Reply","visible":false}
{"do":"quit"}
