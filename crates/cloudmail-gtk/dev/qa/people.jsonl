# The admin's People window and the Accounts window, on dev/fake-worker's stand-in data. QA's shots are of the main
# window; dev/preview.sh pictures these.

# Who reads their mail on the worker; an invite needs a name, and then shows the link to send.
{"do":"click","role":"button","name":"Who else reads their mail on your worker; invite someone"}
{"do":"wait","role":"label","name":"sam · connected","visible":true}
{"do":"wait","role":"button","name":"New invite link","visible":true}
{"do":"click","role":"button","name":"Invite"}
{"do":"wait","role":"label","name":"Give them a name first: it's how you refer to them, like sam.","visible":true}
{"do":"type","role":"text-box","name":"name, like sam","text":"lee"}
{"do":"type","role":"text-box","name":"their addresses, comma-separated","text":"lee@example.org"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"label","name":"cloudmail connect https://mail.example.org/invite/c0ffee","visible":true}
{"do":"wait","role":"button","name":"Copy link","visible":true}

# Signing someone out asks first, in a window over the People window; Escape keeps them, Sign out does it.
{"do":"click","role":"button","name":"Sign out"}
{"do":"wait","dialog":"Sign sam out everywhere?"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}
{"do":"click","role":"button","name":"Sign out"}
{"do":"wait","dialog":"Sign sam out everywhere?"}
{"do":"click","role":"button","name":"Sign out","in":{"role":"dialog","name":"Sign sam out everywhere?"}}
{"do":"wait","dialog":null}
{"do":"wait","role":"label","name":"Signed sam out.","visible":true}
{"do":"click","role":"button","name":"Close","in":{"role":"window","name":"People"}}
{"do":"wait","role":"window","name":"People","visible":false}

# The linked accounts: none yet, and a button for each kind.
{"do":"click","role":"button","name":"Linked accounts: HEY, Gmail, iCloud Mail"}
{"do":"wait","role":"button","name":"Gmail","in":{"role":"window","name":"Accounts"},"visible":true}
{"do":"wait","role":"button","name":"iCloud Mail","in":{"role":"window","name":"Accounts"},"visible":true}
{"do":"wait","role":"button","name":"HEY","in":{"role":"window","name":"Accounts"},"visible":true}
{"do":"wait","role":"label","name":"None yet: link one below.","visible":true}
{"do":"click","role":"button","name":"Close","in":{"role":"window","name":"Accounts"}}
{"do":"wait","role":"window","name":"Accounts","visible":false}
{"do":"quit"}
