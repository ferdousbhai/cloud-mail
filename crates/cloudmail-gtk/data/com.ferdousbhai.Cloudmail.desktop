[Desktop Entry]
Version=1.0
Type=Application
Name=Cloudmail
Comment=Email on your own domains, plus Gmail, iCloud Mail and HEY
Exec=cloudmail-gtk %u
Icon=com.ferdousbhai.Cloudmail
Terminal=false
Categories=Network;Email;
Keywords=email;mail;screener;gmail;icloud;hey;
MimeType=x-scheme-handler/mailto;
StartupNotify=true
StartupWMClass=com.ferdousbhai.Cloudmail
